# ── 与作者配置对齐的关闭项 ───────────────────────────────
# 同上：这些在官方 defconfig 里被显式关闭，默认却是 y。
# 一并抄过来，避免因默认值不同引入意外差异。

# CONFIG_GDB is not set
# CONFIG_KERNEL_BLK_DEV_THROTTLING is not set
# CONFIG_KERNEL_CFS_BANDWIDTH is not set
# CONFIG_KERNEL_KEYS is not set
# CONFIG_KERNEL_MEMCG_SWAP is not set
# CONFIG_OPENSSL_ENGINE_BUILTIN is not set
# CONFIG_OPENSSL_PREFER_CHACHA_OVER_GCM is not set
# CONFIG_PACKAGE_TURBOACC_INCLUDE_FLOW_OFFLOADING is not set
# CONFIG_PACKAGE_swconfig is not set
# CONFIG_PKG_CHECK_FORMAT_SECURITY is not set
# CONFIG_PKG_FORTIFY_SOURCE_1 is not set
# CONFIG_WOLFSSL_HAS_ECC25519 is not set
# CONFIG_AFALG_FALLBACK is not set

# ── 无线相关用户态包 ────────────────────────────────────────
# kmod-mt_wifi 的依赖（wifi-dats / kmod-conninfra / kmod-warp /
# kmod-mediatek_hnat）会由 make defconfig 自动展开；这里显式写出是为了
# 让 CI 能校验，避免再次被静默丢弃。
CONFIG_PACKAGE_kmod-mt_wifi=y
CONFIG_PACKAGE_kmod-warp=y
CONFIG_PACKAGE_kmod-conninfra=y
CONFIG_PACKAGE_wifi-dats=y
CONFIG_PACKAGE_mtwifi-cfg=y
CONFIG_PACKAGE_datconf=y
CONFIG_PACKAGE_datconf-lua=y
CONFIG_PACKAGE_kvcedit=y
CONFIG_PACKAGE_libkvcutil=y
CONFIG_PACKAGE_mtk-smp=y
CONFIG_PACKAGE_wifi-scripts=y
CONFIG_PACKAGE_wireless-regdb=y
CONFIG_PACKAGE_wireless-tools=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_iwinfo=y
# LuCI 无线配置界面（闭源驱动用 mtwifi-cfg 的页面）
CONFIG_PACKAGE_luci-app-mtwifi-cfg=y
CONFIG_PACKAGE_luci-i18n-mtwifi-cfg-zh-cn=y

# ── ④ 网页管理界面 ─────────────────────────────────────────
CONFIG_PACKAGE_luci=y

# ── ⑤ LuCI「软件包」页面（24.10 改名，两个都写做兜底）──────
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y

# ── ⑥ 防火墙页面 ───────────────────────────────────────────
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y

# ── ⑦ 中文界面 ─────────────────────────────────────────────
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# ── ⑧ 支撑「按需安装」的最小闭环 ───────────────────────────
CONFIG_PACKAGE_opkg=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_libustream-openssl=y

# ── ⑨ 拨号（PPPoE）─────────────────────────────────────────
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y

# ── ⑩ 流量转发卸载 ─────────────────────────────────────────
CONFIG_PACKAGE_kmod-nft-offload=y

# ══════════════════════════════════════════════════════════════
# 未列出的包一律不编译：PassWall / AdGuardHome / Tailscale / Argon /
# vnStat / nlbwmon / WOL / UPnP / zram-swap 等，需要时刷完后
#     opkg update && opkg install luci-app-xxx
# MTK 调试工具（mii_mgr / mtkhqos_util / regs / switch）也未启用，
# 它们不是无线工作的必要条件。
#
# ══════════════════════════════════════════════════════════════
# ★ 为什么【只】改这一个文件就够了？
#
# device.mk（不需要改）：
#   是否要在 DEVICE_PACKAGES 里写无线包？不需要。
#   已核对 target/linux/mediatek/image/filogic.mk：134 处 DEVICE_PACKAGES
#   【没有任何一处】出现 kmod-mt_wifi —— 全都是那堆不存在的 kmod-mt7915e。
#   也就是说：本源码所有 MT7981 机型的闭源无线驱动，都不是靠 DEVICE_PACKAGES
#   带出来的，而是靠 .config 里的 CONFIG_PACKAGE_kmod-mt_wifi=y。
#   官方 defconfig/mt7981-ax3000.config 正是这么写的。⇒ 照做即可。
#
# DTS（不需要改）：
#   闭源驱动读 EEPROM 走的是 MTD 分区【名】，不是 device tree 的 nvmem：
#     ee_flash.c → mt_mtd_read_nm_wifi("Factory", off, ...)
#     mt_wifi_mtd.c → get_mtd_device_nm("Factory")，失败再试 "factory"
#   只要求 DTS 里那个 2MB 分区的 label = "factory" —— 你原来的 DTS 本来就有。
#   &wifi 节点（mediatek,mtd-eeprom / nvmem-cells）是给开源 mt76 用的，
#   而 mt76 在这份源码里根本不存在，该节点无人消费，保留或删除都不影响。
#
# prepare-source.py（不需要改）：
#   它只负责板级移植（DTS / 机型注册 / 网络 MAC / sysupgrade），
#   与无线无关。EEPROM 偏移的编译期改动已确认有害并撤销。
# ══════════════════════════════════════════════════════════════
#
# ⚠️ 唯一未能从软件确认的项：功放类型 CONFIG_MTK_FIRST_IF_IPAILNA
#    （内置功放，公模 MT7981 最常见）。若刷出后信号明显偏弱，
#    改成 CONFIG_MTK_FIRST_IF_EPAELNA=y 重编即可。
#    这项【不影响有没有 WiFi】，只影响发射功率。
# ══════════════════════════════════════════════════════════════
