# ══════════════════════════════════════════════════════════════
# WF3000A —— 纯净固件配置（意图清单）
#
# ★ 这是修复「固件没有无线」所需的【唯一必需改动文件】。
#   device.mk / DTS / prepare-source.py 都不需要改，理由见本文件末尾说明。
#
# 本文件所有无线相关取值均已【实机 + 源码双重确认】，依据写在对应段落。
# 依赖不需要手写：make defconfig 会沿依赖树自动展开。
# ══════════════════════════════════════════════════════════════

# ══════════════════════════════════════════════════════════════
# ★ 与恩山「小圆」实测可用固件的交叉核对结论（最重要的一条）
# ────────────────────────────────────────────────────────────
# 小圆的 WF3000A 固件基于同一份源码，有线/无线【实测均正常】。
# 他的 filogic.mk 里写的是：
#     DEVICE_PACKAGES := kmod-mt7981-firmware mt7981-wo-firmware
#
# 但这两行是【死引用】，对无线零作用。已递归核对
# padavanonly/immortalwrt-mt798x-6.6 全部 12803 个文件确认：
#   · package/kernel/mt76 目录不存在（命中的 803 处全是 mt7622/7623/7629 老芯片）
#   · 全树没有任何 Makefile 定义 mt7981-firmware / mt7981-wo-firmware
#     （"wo-firmware" 唯一命中只是 target/linux/generic 下的一个 WED 补丁名）
#   ⇒ 这两个名字会被 make defconfig 静默丢弃。
#
# 那小圆的无线为什么能用？因为他的 config 基于
# defconfig/mt7981-ax3000.config，那份配置里有：
#     CONFIG_PACKAGE_kmod-mt_wifi=y   ← 真正的无线来源（MTK 闭源驱动）
# 本工程正是照抄这份 defconfig 的驱动符号块 ⇒ 与小圆同源，无线可用。
#
# 小圆固件唯一的毛病是【MAC 随机】：他的 DTS 里 gmac0/gmac1 没有
# nvmem-cells，也没有 label-mac-device。本工程已解决：
#   · DTS：gmac0/gmac1 挂 nvmem-cells = <&macaddr_factory_4>
#   · 02_network：由 prepare-source.py 写入 kst,wf3000a 分支，
#     从 factory 偏移读取基准再推算：LAN=基准-1  WAN=基准-2（每台机器各不相同）
#   · 无线 MAC 取自 EEPROM：2.4G=F7(0x4) / 5G=F8(0xa)
#
# 插件繁多：小圆那版带一堆第三方插件。本文件只保留
# 官方默认包 + LuCI(中文) + HNAT 硬件加速 + 无线驱动/固件 ⇒ 纯净固件。
#
# 分区布局与小圆完全一致（114MiB），已删除他的 -256m 变体。
# ══════════════════════════════════════════════════════════════

# ══════════════════════════════════════════════════════════════
# ★ 与上游参考工程 Anser-y/WF3000A-ImmortalWrt-6.6 的交叉核对结论
# ────────────────────────────────────────────────────────────
# 1) Anser-y 的 config/wf3000a.config 里【没有任何无线配置】：
#    既没有 CONFIG_PACKAGE_kmod-mt_wifi，也没有任何 CONFIG_MTK_* 驱动开关。
#    ⇒ 那份工程【不能】作为"无线正常"的参照物 —— 按它的代码原样编译，
#      出来的固件同样没有 WiFi。它自己的 README 也写着
#      "尚未在你的具体硬件上实机验证"。
#
# 2) 无线不会自动带出来，已用两条证据确认：
#    · target/linux/mediatek/filogic/target.mk 的 DEFAULT_PACKAGES 只有
#      fitblk / kmod-phy-aquantia / kmod-crypto-hw-safexcel / wpad-openssl /
#      uboot-envtools —— 没有 mt_wifi，也没有 mt7915e。
#    · filogic.mk 里 134 处 DEVICE_PACKAGES 无一出现 kmod-mt_wifi
#      （全是包不存在的 kmod-mt7915e 死引用）。
#    ⇒ 无线必须在本文件里【显式】写 =y。
#
# 3) 驱动符号必须【连 "is not set" 一起】照抄源码自带的
#    defconfig/mt7981-ax3000.config，不能只抄 =y 的项。
#    上次编译失败就是漏抄了两条（见下方 PRE_CAL 段落）。
#    build.yml 第 7 步会拿该 defconfig 做【双向】比对，有差异直接拦下。
#
# 本工程与 Anser-y 的【刻意差异】（不是问题）：
#    · 分区 248MiB → 114MiB（本机实际 flash 为 128MB）
#    · 去掉 PassWall / AdGuardHome / Tailscale / Argon 等插件 → 纯净固件
#    · 源码从"锁定 commit"改为 fork 的分支引用（可按需要改成 SHA）
# ══════════════════════════════════════════════════════════════

CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_kst_wf3000a=y
#  ↑ 这个符号不写，filogic 下几十个机型会全编一遍（几小时）
#  ↑ 它存在的前提是 device.mk 已追加到 filogic.mk（由 prepare-source.py 完成）

# ── ② 文件系统 ─────────────────────────────────────────────
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# 本机是 SPI-NAND，rootfs 为 UBI volume，大小由 IMAGE_SIZE(115712k)
# 与 UBINIZE_OPTS 决定，PARTSIZE 不生效，不写。

# ── ③ 硬件加速：HNAT 内核驱动 ──────────────────────────────
# kmod-mediatek_hnat 同时也是 kmod-mt_wifi 的硬依赖（mt_wifi/Makefile: DEPENDS）
CONFIG_PACKAGE_kmod-mediatek_hnat=y

# ══════════════════════════════════════════════════════════════
# ③b 无线：MTK 闭源驱动（★ 本固件有没有 WiFi，全看这一段）──
# ────────────────────────────────────────────────────────────
# 【根因】这份源码【没有】开源 mt76 —— package/kernel/mt76 不存在
#   （已递归核对源码树全部 15976 个文件确认）。
#   filogic.mk 里那 104 处 kmod-mt7915e / 70 处 kmod-mt7981-firmware /
#   mt7981-wo-firmware 是上游 immortalwrt 的【死引用】——包根本不存在，
#   写进 DEVICE_PACKAGES 或 .config 会被 make defconfig 静默丢弃，
#   编译照常成功 → 编出没有 WiFi 的固件。这正是原来的问题。
#
# 【正解】本源码真实可用的无线是源码自带的 MTK 闭源驱动：
#   package/mtk/drivers/mt_wifi      → kmod-mt_wifi     (mt_wifi.ko)
#   package/mtk/drivers/warp         → kmod-warp        (WED 硬件卸载)
#   package/mtk/drivers/conninfra    → kmod-conninfra   (连接基础设施)
#   package/mtk/drivers/wifi-profile → wifi-dats        (l1profile / *.dat)
#   package/mtk/applications/mtwifi-cfg → mtwifi-cfg    (无线配置工具)
# 驱动源码(src/)、固件(files/mt7981-fw-20240613/)、默认 EEPROM 全在仓库内，
# 不依赖任何外部下载。
#
# 【EEPROM 偏移：编译期保持官方 0xc0000，运行期才是 0x0】
#
#   ⚠️ 本次 CI 实测结论（重要）：
#      把 CONFIG_MTK_RT_FIRST_IF_RF_OFFSET 改成 0x0 会导致闭源驱动【编译失败】：
#        mt_wifi/embedded/common/eeprom.c: error: 'A32_RT2_OFFSET' undeclared
#        make[6]: *** [scripts/Makefile.build:243: .../common/eeprom.o] Error 1
#        ERROR: package/mtk/drivers/mt_wifi failed to build.
#      原因：A32_RT2_OFFSET 等 EEPROM 分区布局的内部符号只在官方默认
#      （0xc0000）代码路径下定义；改成 0x0 会走进另一条分支，引用未定义符号。
#      ⇒ 本项【不写】，保持官方 default 0xc0000。
#
#   那本机的 0x0 怎么保证？靠【运行期覆盖】：
#      package/mtk/drivers/wifi-profile/files/mt7981/l1profile.dat
#        INDEX0_EEPROM_offset=0x0
#        INDEX0_EEPROM_size=0x5000
#        INDEX0_EEPROM_name=e2p
#      rt_profile.c 的 l1set_eeprom_offset() 解析 .dat 写入
#      l1profile[].ee_info.offset，get_dev_eeprom_offset() 返回它，
#      RtmpFlashRead(..., get_dev_eeprom_offset(pAd), ...) 用它读 flash。
#
#   实机证据（factory 分区前 16 字节）：
#      0x00 = 81 79 → 小端 u16 = 0x7981 = MT7981 chipid（驱动正是这么校验）
#      0x04 = 48:DA:35:50:70:F7  (2.4G MAC)
#      0x0a = 48:DA:35:50:70:F8  (5G  MAC)
#    ⇒ EEPROM 确实在 factory 分区偏移 0，运行期覆盖后能正确读到原厂校准。
#
#   最坏情况（覆盖不生效）：驱动校验 chipid 失败 → 回退 /lib/firmware 默认
#   EEPROM → WiFi 照样起来，只是用通用校准值、MAC 随机。不会「没有无线」。
#
# 【安全阀】即使 EEPROM 读取失败，驱动也会回退到 /lib/firmware 下的
#   默认 MT7981 EEPROM（e2p / MT7981_iPAiLNA_EEPROM.bin），
#   WiFi 照样能起来，只是用通用校准值。⇒ 不会「没有无线」。
# ══════════════════════════════════════════════════════════════

# ══════════════════════════════════════════════════════════════
# ★★ 上次编译失败的根因（已修复，勿回退）★★
# ────────────────────────────────────────────────────────────
# 报错（mt_wifi/embedded/common/eeprom.c）：
#   508  PRE_CAL_SIZE_ONE_CARD undeclared
#   539  PRECALPART_OFFSET     undeclared
#   1191 DCOC_IMAGE_SIZE       undeclared
#   1192 TXDPD_IMAGE1_SIZE     undeclared
#   1193 TXDPD_IMAGE2_SIZE     undeclared
#   1205 DPDPART1_OFFSET       undeclared
#   1207 DPDPART2_OFFSET       undeclared
#   ERROR: package/mtk/drivers/mt_wifi failed to build.
#
# 原因：MTK_PRE_CAL_TRX_SET1/SET2_SUPPORT 在 mt_wifi/config.in 里是
#       default y。上游 defconfig 显式关闭了它们，而我上一版只抄了 =y 的项、
#       漏了这两条 "is not set" → 默认 y 生效 → 编译"预校准(pre-cal)
#       分区"代码路径 → MT7981 头文件里没有上面这批符号 → 编译失败。
#
# 已在源码中逐行确认这 7 个报错点全部位于条件编译块内：
#   eeprom.c:506  #ifdef PRE_CAL_TRX_SET2_SUPPORT   ← 覆盖 508 / 539
#   eeprom.c:1189 #ifdef PRE_CAL_TRX_SET1_SUPPORT   ← 覆盖 1191/92/93/1205/1207
#   ⇒ 关掉这两个开关，7 个报错点整块不编译。
# ══════════════════════════════════════════════════════════════

# ── 驱动编译开关（逐行照抄源码自带 defconfig/mt7981-ax3000.config）──
#
# ⚠️ 必须【连 "is not set" 行一起抄】，不能只抄 =y 的项。
#    这批符号在 config.in 里是 default y，不显式写 "# CONFIG_X is not set"
#    就会被默认打开 —— 这正是上一次编译失败的根因：
#
#      eeprom.c:508  error: PRE_CAL_SIZE_ONE_CARD undeclared
#      eeprom.c:539  error: PRECALPART_OFFSET     undeclared
#      eeprom.c:1191 error: DCOC_IMAGE_SIZE       undeclared
#      eeprom.c:1192 error: TXDPD_IMAGE1_SIZE     undeclared
#      eeprom.c:1193 error: TXDPD_IMAGE2_SIZE     undeclared
#      eeprom.c:1205 error: DPDPART1_OFFSET       undeclared
#      eeprom.c:1207 error: DPDPART2_OFFSET       undeclared
#      ERROR: package/mtk/drivers/mt_wifi failed to build.
#
#    原因：MTK_PRE_CAL_TRX_SET1/SET2_SUPPORT 默认 y，一旦打开就会编译
#    「预校准(pre-cal)分区」代码路径，而 MT7981 的头文件里没有定义
#    上面那批符号 ⇒ 编译失败。作者的配置里这两项是显式关闭的。
#
#    教训：只比对"我写了什么"是不够的，还要比对"官方禁用了什么"。

CONFIG_CONNINFRA_AUTO_UP=y
CONFIG_CONNINFRA_EMI_SUPPORT=y
CONFIG_MTK_ACK_CTS_TIMEOUT_SUPPORT=y
